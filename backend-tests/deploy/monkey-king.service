# systemd service: keeps the game running on port 80, and restarts it after a crash or reboot.
# Install (on the server, from the project folder):
#   sudo cp deploy/monkey-king.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now monkey-king
# Logs:  sudo journalctl -u monkey-king -f
[Unit]
Description=The Stolen Hours of the Monkey King
After=network-online.target
Wants=network-online.target

[Service]
User=opc
WorkingDirectory=/home/opc/monkey-king
# One worker process on purpose: if MySQL is down, the memory fallback must live in ONE process.
# Start through the venv's python (a link to /usr/bin/python3.12), not the uvicorn script:
# SELinux on Oracle Linux blocks systemd from running script files stored in /home.
ExecStart=/home/opc/monkey-king/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 80
# Lets the opc user use port 80 without running the whole app as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
