# Copy this file to .env and fill it in:   cp .env.example .env
# .env holds secrets. It is listed in .gitignore, so it never goes to GitHub.

# ---- Database (MySQL HeatWave) ----
# STORE: mysql | memory | auto (auto = mysql if DB_HOST is set, otherwise memory)
STORE=mysql
DB_HOST=10.0.1.185
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=change-me
DB_NAME=monkey_king
# If MySQL is down when the server starts, keep running from memory (design doc fallback).
FALLBACK_TO_MEMORY=1

# ---- AI narrator (OCI Generative AI) ----
# AI_ENABLED=0 runs the whole game on pre-written lines (no AI calls at all).
AI_ENABLED=1
AI_TIMEOUT_S=6
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
# The compartment that may use Generative AI. On a free trial the tenancy OCID works
# (it is the "tenancy=" line in ~/.oci/config).
OCI_COMPARTMENT_ID=ocid1.tenancy.oc1..paste-yours-here
OCI_GENAI_ENDPOINT=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com
# Free Trial: use Cohere Command A (Grok is not supported in the Free Trial).
OCI_GENAI_MODEL=cohere.command-a-03-2025

# ---- Teacher view ----
# Optional passcode for /teacher (so students can't open it). Empty = no code needed.
TEACHER_CODE=
